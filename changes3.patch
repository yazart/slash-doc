++    const y = finiteAttribute(match[1], 'y');
++    const width = finiteAttribute(match[1], 'width');
++    const height = finiteAttribute(match[1], 'height');
++    if (x === undefined || y === undefined || width === undefined || height === undefined || width < 0 || height < 0) {

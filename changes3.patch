++function readDiagramBounds(xml: string): BpmnSvgDimensions | undefined {
++  let bounds: Bounds | undefined;
++  for (const match of xml.matchAll(/<(?:[a-z_][\w.-]*:)?Bounds\b([^>]*)>/gi)) {

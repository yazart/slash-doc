@@ -0,0 +1,144 @@
+import { isNodeInsideSelector } from './shadow-dom';
+import type { API } from './block-editor-types';
+import type { BlockEditorElement } from './block-editor-element';
+import { focusBlock, selectionApi, toolSettings } from './block-editor-view';
+import { sanitizeTableCellHtml } from '../shared/table-cell-html';
+
+export function createEditorApi(editor: BlockEditorElement): API {
+  const events = new EventTarget();
+  return {
+    blocks: {
+      getCurrentBlockIndex: () => editor.currentIndex,
+      getBlocksCount: () => editor.views.length,
+      getBlockByIndex: (index) => editor.views[index]?.api,
+      getById: (id) => editor.views.find((view) => view.output.id === id)?.api,
+      getBlockIndex: (id) => editor.indexOf(id),
+      getBlockByElement: (element) =>
+        editor.views.find((view) =>
+          isNodeInsideSelector(element, `.ce-block[data-id="${CSS.escape(view.output.id!)}"]`),
+        )?.api,
+      insert: (type, data, config, index, focus, replace, id) => {
+        if (replace) editor.deleteBlock(index ?? editor.currentIndex, false);
+        return editor.insert(
+          { type: type ?? editor.config.defaultBlock ?? 'paragraph', data: data ?? {}, id },
+          index,
+          focus,
+          config,
+        ).api;
+      },
+      delete: (index) => editor.deleteBlock(index ?? editor.currentIndex),
+      move: (to, from) => editor.move(to, from ?? editor.currentIndex),
+      swap: (from, to) => {
+        if (editor.readOnly) return;
+        const first = editor.views[from];
+        const second = editor.views[to];
+        if (!first || !second) return;
+        editor.views[from] = second;
+        editor.views[to] = first;
+        editor.syncOrder();
+        editor.changed();
+      },
+      clear: () => {
+        void editor.render({ blocks: [] }).then(() => editor.changed());
+      },
+      render: (data) => editor.render(data),
+      renderFromHTML: (html) =>
+        editor.render({ blocks: [{ type: 'paragraph', data: { text: sanitizeTableCellHtml(html) } }] }),
+      update: async (id, data) => {
+        const index = editor.indexOf(id);
+        const old = editor.views[index];
+        if (!old) return undefined;
+        const saved = await old.api.save();
+        editor.deleteBlock(index, false);
+        return editor.insert({ ...saved, data: { ...saved.data, ...data } }, index, false).api;
+      },
+      composeBlockData: async (type) => {
+        const settings = toolSettings(editor.config.tools ?? {}, type);
+        if (!settings) return {};
+        const tool = new settings.class({
+          data: {},
+          config: settings.config ?? {},
+          api: editor.api,
+          readOnly: true,
+          block: {},
+        });
+        try {
+          return await tool.save(tool.render());
+        } finally {
+          tool.destroy?.();
+        }
+      },
+      stretchBlock: (index, status) => editor.views[index]?.holder.classList.toggle('ce-block--stretched', status),
+    },
+    caret: {
+      setToBlock: (index, position, offset) => {
+        const number = typeof index === 'number' ? index : editor.indexOf(typeof index === 'string' ? index : index.id);
+        editor.currentIndex = number;
+        editor.clearSelection();
+        return focusBlock(editor.views[number], position, offset);
+      },
+      setToFirstBlock(position) {
+        return this.setToBlock(0, position);
+      },
+      setToLastBlock(position) {
+        return this.setToBlock(editor.views.length - 1, position);
+      },
+    },
+    selection: selectionApi(),
+    saver: { save: () => editor.save() },
+    readOnly: {
+      get isEnabled() {
+        return editor.readOnly;
+      },
+      async toggle(state = !editor.readOnly) {
+        const data = await editor.save();
+        editor.config.readOnly = state;
+        await editor.render(data);
+        return state;
+      },
+    },
+    listeners: {
+      on: (element, type, handler, capture) => {
+        element.addEventListener(type, handler, capture);
+        editor.cleanups.push(() => element.removeEventListener(type, handler, capture));
+      },
+      off: (element, type, handler, capture) => element.removeEventListener(type, handler, capture),
+    },
+    events: {
+      on: (name, handler) => events.addEventListener(name, handler),
+      off: (name, handler) => events.removeEventListener(name, handler),
+      emit: (name, data) => events.dispatchEvent(new CustomEvent(name, { detail: data })),
+    },
+    inlineToolbar: {
+      close: () =>
+        editor.querySelectorAll<HTMLElement>('.slash-text-inline-toolbar').forEach((element) => {
+          element.hidden = true;
+        }),
+      open: () => undefined,
+    },
+    toolbar: {
+      close: () => undefined,
+      open: () => undefined,
+      toggleBlockSettings: () =>
+        editor.views[editor.currentIndex]?.holder
+          .querySelector<HTMLButtonElement>('[aria-label="Настройки блока"]')
+          ?.click(),
+    },
+    sanitizer: { clean: (html) => sanitizeTableCellHtml(html) },
+    styles: {
+      block: 'cdx-block',
+      input: 'cdx-input',
+      button: 'cdx-button',
+      settingsButton: 'cdx-settings-button',
+      settingsButtonActive: 'cdx-settings-button--active',
+      inlineToolButton: 'ce-inline-tool',
+      inlineToolButtonActive: 'ce-inline-tool--active',
+    },
+    i18n: { t: (text) => editor.config.i18n?.messages?.toolNames?.[text] ?? text },
+    notifier: {
+      show: ({ message }) => {
+        editor.status.textContent = message;
+      },
+    },
+  };
+}
diff --git a/src/webview/block-editor-clipboard.ts b/src/webview/block-editor-clipboard.ts
new file mode 100644
index 0000000..e48f4c4
--- /dev/null
+++ b/src/webview/block-editor-clipboard.ts
@@ -0,0 +1,69 @@
+import type { BlockEditorElement } from './block-editor-element';
+import { BLOCK_CLIPBOARD_MIME, decodeBlockClipboard, encodeBlockClipboard } from './block-clipboard';
+import { snapshotBlock } from './block-editor-view';
+import { pasteClipboardImages } from './block-editor-image-paste';
+
+export function installBlockClipboard(editor: BlockEditorElement): () => void {
+  const contains = (event: Event) => event.composedPath().includes(editor);
+  const consume = (event: Event) => {
+    event.preventDefault();
+    event.stopImmediatePropagation();
+  };
+  const copy = (event: ClipboardEvent) => {
+    if (!contains(event) || !editor.selected.size) return;
+    const blocks = editor.views.filter((view) => editor.selected.has(view.output.id!)).map(snapshotBlock);
+    const text = encodeBlockClipboard(blocks);
+    if (!event.clipboardData) return;
+    event.clipboardData.setData(BLOCK_CLIPBOARD_MIME, text);
+    event.clipboardData.setData('text/plain', text);
+    consume(event);
+    if (event.type === 'cut' && !editor.readOnly) editor.deleteSelected();
+  };
+  const paste = (event: ClipboardEvent) => {
+    if (!contains(event) || editor.readOnly || event.defaultPrevented) return;
+    if (isTextControl(event)) {
+      pasteClipboardImages(editor, event);
+      return;
+    }
+    const text = event.clipboardData?.getData(BLOCK_CLIPBOARD_MIME) || event.clipboardData?.getData('text/plain') || '';
+    const blocks = decodeBlockClipboard(text);
+    if (blocks) {
+      consume(event);
+      editor.pasteBlocks(blocks);
+    } else pasteClipboardImages(editor, event);
+  };
+  const keydown = (event: KeyboardEvent) => {
+    if (!contains(event) || !editor.selected.size || isTextControl(event)) return;
+    if ((event.ctrlKey || event.metaKey) && !event.altKey) {
+      if (event.code === 'KeyA') {
+        consume(event);
+        editor.views.forEach((view) => editor.selected.add(view.output.id!));
+        editor.refreshSelection();
+      }
+      if (event.code === 'KeyC' || event.code === 'KeyX') {
+        consume(event);
+        void editor.copySelection(event.code === 'KeyX');
+      }
+    }
+  };
+  window.addEventListener('copy', copy, true);
+  window.addEventListener('cut', copy, true);
+  window.addEventListener('paste', paste, true);
+  window.addEventListener('keydown', keydown, true);
+  return () => {
+    window.removeEventListener('copy', copy, true);
+    window.removeEventListener('cut', copy, true);
+    window.removeEventListener('paste', paste, true);
+    window.removeEventListener('keydown', keydown, true);
+  };
+}
+function isTextControl(event: Event): boolean {
+  return event
+    .composedPath()
+    .some(
+      (target) =>
+        target instanceof HTMLInputElement ||
+        target instanceof HTMLTextAreaElement ||
+        target instanceof HTMLSelectElement,
+    );
+}
diff --git a/src/webview/block-editor-conversion.ts b/src/webview/block-editor-conversion.ts
new file mode 100644
index 0000000..4286187
--- /dev/null
+++ b/src/webview/block-editor-conversion.ts
@@ -0,0 +1,92 @@
+import type { BlockEditorElement } from './block-editor-element';
+import type { OutputBlockData } from './block-editor-types';
+import { createBlockView, toolSettings } from './block-editor-view';
+import { sanitizeTableCellHtml, tableCellHtmlToText } from '../shared/table-cell-html';
+import { createTableRows } from './confluence-table-data';
+
+export function blockContent(data: Record<string, any>): string {
+  if (typeof data.text === 'string') return data.text;
+  if (typeof data.content === 'string') return data.content;
+  if (typeof data.code === 'string') return escapeText(data.code).replaceAll('\n', '<br>');
+  if (Array.isArray(data.rows)) return data.rows.map((row: string[]) => row.join(' · ')).join('<br>');
+  if (Array.isArray(data.tabs)) return data.tabs.map((tab: any) => tab.content ?? '').join('<br>');
+  if (Array.isArray(data.items))
+    return data.items
+      .map((item: any) =>
+        typeof item === 'string'
+          ? item
+          : `${item.content ?? item.text ?? ''}${item.items?.length ? `<br>${blockContent({ items: item.items })}` : ''}`,
+      )
+      .join('<br>');
+  return typeof data.caption === 'string' ? data.caption : '';
+}
+export function convertedBlockData(
+  type: string,
+  data: Record<string, any>,
+  content = blockContent(data),
+): Record<string, any> {
+  const text = sanitizeTableCellHtml(content);
+  switch (type) {
+    case 'paragraph':
+    case 'quote':
+      return { text };
+    case 'header':
+      return { text, level: data.level ?? 2 };
+    case 'list':
+      return { style: data.style === 'ordered' ? 'ordered' : 'unordered', items: [{ content: text, items: [] }] };
+    case 'confluenceTable':
+      return { rows: createTableRows(text), headerRow: false, headerColumn: false };
+    case 'mkdocsAdmonition':
+      return { content: text, title: data.title ?? 'Примечание', kind: 'note' };
+    case 'mkdocsDetails':
+      return { content: text, summary: data.title ?? 'Подробнее', open: true };
+    case 'mkdocsTabs':
+      return { tabs: [{ title: 'Вкладка', content: text }] };
+    case 'mkdocsChecklist':
+      return { items: [{ text, checked: false, level: 0 }] };
+    case 'mkdocsGrid':
+      return { cards: true, items: [{ content: text }] };
+    case 'codeBlock':
+      return { code: tableCellHtmlToText(text), language: data.language ?? 'plaintext' };
+    case 'mermaid':
+      return data.code ? { code: data.code, caption: data.caption ?? '' } : { caption: tableCellHtmlToText(text) };
+    case 'image':
+      return { ...data, caption: text };
+    default:
+      return { ...data, text, content: text };
+  }
+}
+export async function convertBlockType(editor: BlockEditorElement, id: string, type: string): Promise<void> {
+  const source = editor.views.find((view) => view.output.id === id);
+  const target = toolSettings(editor.config.tools ?? {}, type);
+  if (!source || !target || target.class.isInline || source.output.type === type || editor.readOnly) return;
+  const saved = await source.api.save();
+  let content = blockContent(saved.data);
+  const exporter = toolSettings(editor.config.tools ?? {}, saved.type)?.class.conversionConfig?.export;
+  if (typeof exporter === 'function') content = exporter(saved.data);
+  else if (exporter && typeof saved.data[exporter] === 'string') content = saved.data[exporter];
+  const importer = target.class.conversionConfig?.import;
+  const data =
+    typeof importer === 'function'
+      ? importer(content)
+      : importer
+        ? { [importer]: content }
+        : convertedBlockData(type, saved.data, content);
+  // Resolve again after an asynchronous addon save; the block may have moved or been removed.
+  const index = editor.views.indexOf(source);
+  if (index < 0 || editor.readOnly) return;
+  const output: OutputBlockData = { ...saved, type, data };
+  const replacement = createBlockView(editor, output);
+  source.tool?.removed?.();
+  source.dispose?.();
+  source.tool?.destroy?.();
+  source.holder.replaceWith(replacement.holder);
+  editor.views[index] = replacement;
+  replacement.tool?.rendered?.();
+  editor.api.caret.setToBlock(index, 'start');
+  editor.refreshSelection();
+  editor.changed(replacement);
+}
+function escapeText(value: string): string {
+  return value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
+}
diff --git a/src/webview/block-editor-drag.ts b/src/webview/block-editor-drag.ts
new file mode 100644
index 0000000..067fc0a
--- /dev/null
+++ b/src/webview/block-editor-drag.ts
@@ -0,0 +1,125 @@
+import type { BlockEditorElement } from './block-editor-element';
+import type { BlockView } from './block-editor-view';
+
+export const BLOCK_MOVE_MIME = 'application/x-slash-doc-move';
+
+/** Move a selection to a boundary in the original ordering, preserving its relative order. */
+export function reorderBlockIds(order: string[], selected: string[], boundary: number): string[] {
+  const moving = new Set(selected);
+  const before = order.slice(0, boundary).filter((id) => !moving.has(id));
+  const after = order.slice(boundary).filter((id) => !moving.has(id));
+  return [...before, ...order.filter((id) => moving.has(id)), ...after];
+}
+
+export function installBlockDrag(editor: BlockEditorElement): () => void {
+  let dragged: string[] = [];
+  let boundary = -1;
+  const viewFor = (event: Event) => editor.views.find((view) => event.composedPath().includes(view.holder));
+  const reset = () => {
+    editor.views.forEach((view) =>
+      view.holder.classList.remove('slash-block-dragging', 'slash-block-drop-before', 'slash-block-drop-after'),
+    );
+    dragged = [];
+    boundary = -1;
+  };
+  const pointerdown = (event: PointerEvent) => {
+    const view = viewFor(event);
+    if (!view || editor.readOnly) return;
+    // Editing text and using a widget must retain their native pointer interactions.
+    view.holder.draggable = !event
+      .composedPath()
+      .some(
+        (node) =>
+          node instanceof HTMLElement &&
+          (node === view.content ||
+            node.isContentEditable ||
+            node.matches('input, textarea, select, a, button:not(.slash-block-handle), .slash-block-insertion-space')),
+      );
+  };
+  const start = (event: DragEvent) => {
+    const view = viewFor(event);
+    if (!view || editor.readOnly || !view.holder.draggable || !event.dataTransfer) return;
+    if (
+      event.target !== view.holder &&
+      !(event.target instanceof HTMLElement && event.target.matches('.slash-block-handle'))
+    )
+      return;
+    dragged = editor.selected.has(view.output.id!)
+      ? editor.views.filter((item) => editor.selected.has(item.output.id!)).map((item) => item.output.id!)
+      : [view.output.id!];
+    event.dataTransfer.setData(BLOCK_MOVE_MIME, JSON.stringify(dragged));
+    event.dataTransfer.effectAllowed = 'move';
+    const rect = view.holder.getBoundingClientRect();
+    // The actual block includes rendered Shadow DOM widgets, which cloneNode would omit.
+    event.dataTransfer.setDragImage(
+      view.holder,
+      Math.max(0, event.clientX - rect.left),
+      Math.max(0, event.clientY - rect.top),
+    );
+    requestAnimationFrame(() => {
+      if (dragged.length)
+        editor.views
+          .filter((item) => dragged.includes(item.output.id!))
+          .forEach((item) => item.holder.classList.add('slash-block-dragging'));
+    });
+    editor.closeBlockMenu();
+    event.stopPropagation();
+  };
+  const over = (event: DragEvent) => {
+    if (editor.readOnly || !dragged.length || !event.dataTransfer?.types.includes(BLOCK_MOVE_MIME)) return;
+    event.preventDefault();
+    event.stopPropagation();
+    event.dataTransfer.dropEffect = 'move';
+    editor.views.forEach((view) => view.holder.classList.remove('slash-block-drop-before', 'slash-block-drop-after'));
+    const view = viewFor(event);
+    if (view) {
+      const rect = view.holder.getBoundingClientRect();
+      const after = event.clientY >= rect.top + rect.height / 2;
+      boundary = editor.indexOf(view.output.id!) + Number(after);
+      view.holder.classList.add(after ? 'slash-block-drop-after' : 'slash-block-drop-before');
+    } else {
+      boundary = editor.views.findIndex((item) => event.clientY < item.holder.getBoundingClientRect().top);
+      if (boundary < 0) boundary = editor.views.length;
+      const target = editor.views[boundary] ?? editor.views.at(-1);
+      target?.holder.classList.add(
+        boundary === editor.views.length ? 'slash-block-drop-after' : 'slash-block-drop-before',
+      );
+    }
+  };
+  const drop = (event: DragEvent) => {
+    if (!dragged.length || boundary < 0 || editor.readOnly || !event.dataTransfer?.types.includes(BLOCK_MOVE_MIME))
+      return;
+    event.preventDefault();
+    event.stopPropagation();
+    const previous = [...editor.views];
+    const order = reorderBlockIds(
+      previous.map((view) => view.output.id!),
+      dragged,
+      boundary,
+    );
+    editor.views = order.map((id) => previous.find((view) => view.output.id === id)!);
+    editor.syncOrder();
+    editor.currentIndex = editor.indexOf(dragged[0]);
+    for (const id of dragged) {
+      const view = editor.views.find((item) => item.output.id === id) as BlockView;
+      view.tool?.moved?.(
+        new CustomEvent('moved', { detail: { fromIndex: previous.indexOf(view), toIndex: editor.indexOf(id) } }),
+      );
+    }
+    reset();
+    editor.changed(undefined, 'block-moved');
+  };
+  editor.addEventListener('pointerdown', pointerdown, true);
+  editor.addEventListener('dragstart', start);
+  editor.addEventListener('dragover', over, true);
+  editor.addEventListener('drop', drop, true);
+  editor.addEventListener('dragend', reset);
+  return () => {
+    reset();
+    editor.removeEventListener('pointerdown', pointerdown, true);
+    editor.removeEventListener('dragstart', start);
+    editor.removeEventListener('dragover', over, true);
+    editor.removeEventListener('drop', drop, true);
+    editor.removeEventListener('dragend', reset);
+  };
+}
diff --git a/src/webview/block-editor-element.ts b/src/webview/block-editor-element.ts
new file mode 100644
index 0000000..ba8b6cb
--- /dev/null
+++ b/src/webview/block-editor-element.ts
@@ -0,0 +1,312 @@
+import { BlockEditorMenu } from './block-editor-menu';
+import { installBlockDrag } from './block-editor-drag';
+import { installBlockInsertion } from './block-editor-insertion';
+import { installBlockAreaSelection } from './block-editor-selection';
+import PersistentParagraphTool from './persistent-paragraph-tool';
+import HeaderTool from './header-tool';
+import QuoteTool from './quote-tool';
+import type { API, EditorConfig, OutputBlockData, OutputData } from './block-editor-types';
+import { createEditorApi } from './block-editor-api';
+import { createBlockView, saveBlock, type BlockView } from './block-editor-view';
+import { installBlockClipboard } from './block-editor-clipboard';
+import { cloneClipboardBlocks, encodeBlockClipboard } from './block-clipboard';
+import { handleBlockKeydown } from './block-editor-keyboard';
+import { handleBlockMovement } from './block-editor-movement';
+import './block-editor.css';
+
+/** Light DOM keeps document styles and existing tool surfaces/addons interoperable. */
+export class BlockEditorElement extends HTMLElement {
+  config: EditorConfig = {};
+  readonly api: API = createEditorApi(this);
+  views: BlockView[] = [];
+  selected = new Set<string>();
+  currentIndex = 0;
+  cleanups: Array<() => void> = [];
+  readonly status = document.createElement('span');
+  private readonly content = document.createElement('div');
+  private readonly menu = new BlockEditorMenu(this);
+  private anchorId?: string;
+  private metadata: Omit<OutputData, 'blocks'> = {};
+  private rendering = false;
+  private destroyed = false;
+  private notifying = false;
+  get readOnly(): boolean {
+    return this.config.readOnly === true;
+  }
+
+  async configure(config: EditorConfig): Promise<void> {
+    this.config = {
+      ...config,
+      tools: {
+        paragraph: PersistentParagraphTool,
+        header: { class: HeaderTool, toolbox: false },
+        quote: QuoteTool,
+        ...config.tools,
+      },
+    };
+    this.className = 'codex-editor slash-block-editor';
+    this.tabIndex = 0;
+    this.setAttribute('role', 'group');
+    this.setAttribute('aria-label', 'Редактор документа');
+    this.content.className = 'codex-editor__redactor';
+    this.content.style.minHeight = `${config.minHeight ?? 180}px`;
+    this.status.className = 'slash-editor-status';
+    this.status.setAttribute('role', 'status');
+    this.replaceChildren(this.status, this.content);
+    this.cleanups.push(
+      installBlockClipboard(this),
+      installBlockDrag(this),
+      installBlockAreaSelection(this),
+      installBlockInsertion(this),
+    );
+    this.addEventListener('focusin', (event) => {
+      this.trackBlock(event);
+      if (event.composedPath().some((target) => target instanceof HTMLElement && target.isContentEditable))
+        this.clearSelection();
+    });
+    this.addEventListener(
+      'pointerdown',
+      (event) => {
+        this.trackBlock(event);
+        const editable = event
+          .composedPath()
+          .some(
+            (target) =>
+              target instanceof HTMLElement && (target.isContentEditable || target.matches('input, textarea, select')),
+          );
+        if (editable) this.clearSelection();
+      },
+      true,
+    );
+    this.addEventListener('input', (event) => {
+      const view = this.viewForEvent(event);
+      view?.tool?.updated?.();
+      this.changed(view);
+    });
+    this.addEventListener('change', (event) => this.changed(this.viewForEvent(event)));
+    this.addEventListener('keydown', (event) => handleBlockKeydown(this, event));
+    this.addEventListener('keydown', (event) => handleBlockMovement(this, event), true);
+    await this.render(config.data ?? { blocks: [] });
+    if (config.autofocus && !this.readOnly) this.api.caret.setToFirstBlock('start');
+    config.onReady?.();
+  }
+  async render(data: OutputData): Promise<void> {
+    this.closeBlockMenu();
+    this.rendering = true;
+    try {
+      for (const view of this.views) {
+        view.dispose?.();
+        view.tool?.destroy?.();
+      }
+      this.views = [];
+      this.content.replaceChildren();
+      this.clearSelection();
+      const { blocks, ...metadata } = structuredClone(data);
+      delete metadata.time;
+      this.metadata = metadata;
+      const ids = new Set<string>();
+      for (const source of blocks) {
+        const block = { ...source };
+        if (!block.id || ids.has(block.id)) block.id = crypto.randomUUID();
+        ids.add(block.id);
+        this.insert(block, this.views.length, false);
+      }
+      if (!this.views.length && !this.readOnly)
+        this.insert({ type: this.config.defaultBlock ?? 'paragraph', data: { text: '' } }, 0, false);
+      this.currentIndex = 0;
+    } finally {
+      this.rendering = false;
+    }
+  }
+  async save(): Promise<OutputData> {
+    const blocks = await Promise.all(this.views.map(saveBlock));
+    return { ...this.metadata, blocks };
+  }
+  insert(source: OutputBlockData, index = this.currentIndex + 1, focus = true, config?: object): BlockView {
+    if (this.readOnly && !this.rendering) throw new Error('Редактор доступен только для чтения');
+    const target = Math.max(0, Math.min(index, this.views.length));
+    if (source.id && this.indexOf(source.id) >= 0) source = { ...source, id: crypto.randomUUID() };
+    const view = createBlockView(this, source, config);
+    this.views.splice(target, 0, view);
+    this.content.insertBefore(view.holder, this.content.children[target] ?? null);
+    view.tool?.rendered?.();
+    if (focus && !this.rendering) this.api.caret.setToBlock(target, 'start');
+    this.changed(view, 'block-added');
+    return view;
+  }
+  deleteBlock(index: number, ensureBlock = true): void {
+    if (this.readOnly) return;
+    const view = this.views[index];
+    if (!view) return;
+    this.views.splice(index, 1);
+    view.tool?.removed?.();
+    view.dispose?.();
+    view.tool?.destroy?.();
+    view.holder.remove();
+    this.selected.delete(view.output.id!);
+    this.currentIndex = Math.max(0, Math.min(index, this.views.length - 1));
+    if (ensureBlock && !this.views.length)
+      this.insert({ type: this.config.defaultBlock ?? 'paragraph', data: { text: '' } }, 0);
+    this.refreshSelection();
+    this.changed(view, 'block-removed');
+  }
+  move(to: number, from: number): void {
+    if (this.readOnly || !this.views[from] || to < 0 || to >= this.views.length || to === from) return;
+    const [view] = this.views.splice(from, 1);
+    this.views.splice(to, 0, view);
+    this.syncOrder();
+    this.currentIndex = to;
+    view.tool?.moved?.(new CustomEvent('moved', { detail: { fromIndex: from, toIndex: to } }));
+    this.changed(view, 'block-moved');
+  }
+  syncOrder(): void {
+    const scrollPositions: Array<{ element: HTMLElement; top: number; left: number }> = [
+      { element: this, top: this.scrollTop, left: this.scrollLeft },
+    ];
+    for (let element = this.parentElement; element; element = element.parentElement) {
+      scrollPositions.push({ element, top: element.scrollTop, left: element.scrollLeft });
+    }
+    // Keep the document mounted: appending every block detaches the whole editor body.
+    let next = this.content.firstElementChild;
+    for (const view of this.views) {
+      if (view.holder !== next) this.content.insertBefore(view.holder, next);
+      next = view.holder.nextElementSibling;
+    }
+    for (const { element, top, left } of scrollPositions) {
+      element.scrollTop = top;
+      element.scrollLeft = left;
+    }
+  }
+  indexOf(id: string): number {
+    return this.views.findIndex((view) => view.output.id === id);
+  }
+  selectBlock(id: string, range = false, additive = false): void {
+    const index = this.indexOf(id);
+    if (index < 0) return;
+    if (range && this.anchorId && this.indexOf(this.anchorId) >= 0) {
+      if (!additive) this.selected.clear();
+      const anchor = this.indexOf(this.anchorId);
+      this.views
+        .slice(Math.min(index, anchor), Math.max(index, anchor) + 1)
+        .forEach((view) => this.selected.add(view.output.id!));
+    } else {
+      if (!additive) this.selected.clear();
+      if (additive && this.selected.has(id)) this.selected.delete(id);
+      else this.selected.add(id);
+      this.anchorId = id;
+    }
+    this.currentIndex = index;
+    window.getSelection()?.removeAllRanges();
+    this.refreshSelection();
+    this.focus({ preventScroll: true });
+    void Promise.all(this.views.filter((view) => this.selected.has(view.output.id!)).map(saveBlock)).catch((error) =>
+      this.reportError(error),
+    );
+  }
+  clearSelection(): void {
+    this.selected.clear();
+    this.anchorId = undefined;
+    this.refreshSelection();
+  }
+  selectBlocks(ids: Iterable<string>, activeId?: string): void {
+    this.selected = new Set([...ids].filter((id) => this.indexOf(id) >= 0));
+    const active = activeId ?? [...this.views].reverse().find((view) => this.selected.has(view.output.id!))?.output.id;
+    this.anchorId = active;
+    if (active) this.currentIndex = this.indexOf(active);
+    this.refreshSelection();
+  }
+  refreshSelection(): void {
+    for (const view of this.views) {
+      const selected = this.selected.has(view.output.id!);
+      view.holder.classList.toggle('ce-block--selected', selected);
+      view.holder.querySelector('.slash-block-handle')?.setAttribute('aria-pressed', String(selected));
+    }
+    this.setAttribute(
+      'aria-label',
+      this.selected.size ? `Редактор документа. Выделено блоков: ${this.selected.size}` : 'Редактор документа',
+    );
+  }
+  async copySelection(cut = false): Promise<void> {
+    const selected = this.views.filter((view) => this.selected.has(view.output.id!));
+    if (!selected.length) return;
+    try {
+      const text = encodeBlockClipboard(await Promise.all(selected.map(saveBlock)));
+      if (window.__SLASH_DOC_WRITE_CLIPBOARD__) await window.__SLASH_DOC_WRITE_CLIPBOARD__(text);
+      else await navigator.clipboard.writeText(text);
+      if (cut && !this.readOnly)
+        for (const view of [...selected].reverse()) this.deleteBlock(this.indexOf(view.output.id!));
+      this.status.textContent = `Скопировано блоков: ${selected.length}`;
+    } catch (error) {
+      this.reportError(error);
+    }
+  }
+  pasteBlocks(blocks: OutputBlockData[]): void {
+    if (this.readOnly) return;
+    const selected = this.views.filter((view) => this.selected.has(view.output.id!));
+    let index = selected.length ? this.indexOf(selected.at(-1)!.output.id!) + 1 : this.currentIndex + 1;
+    this.clearSelection();
+    for (const block of cloneClipboardBlocks(blocks)) {
+      const view = this.insert(block, index++, false);
+      this.selected.add(view.output.id!);
+    }
+    this.currentIndex = index - 1;
+    this.refreshSelection();
+    this.focus();
+    this.changed();
+  }
+  deleteSelected(): void {
+    if (this.readOnly) return;
+    const index = this.views.findIndex((view) => this.selected.has(view.output.id!));
+    for (const view of [...this.views].reverse())
+      if (this.selected.has(view.output.id!)) this.deleteBlock(this.indexOf(view.output.id!), false);
+    this.clearSelection();
+    if (!this.views.length) this.insert({ type: this.config.defaultBlock ?? 'paragraph', data: { text: '' } }, 0);
+    this.api.caret.setToBlock(Math.min(Math.max(0, index), this.views.length - 1), 'start');
+    this.changed();
+  }
+  changed(view?: BlockView, type = 'block-changed'): void {
+    if (this.rendering || this.readOnly || this.destroyed || this.notifying) return;
+    this.notifying = true;
+    queueMicrotask(() => {
+      this.notifying = false;
+      if (this.destroyed || this.rendering) return;
+      const event = new CustomEvent(type, { detail: { target: view?.api }, bubbles: true });
+      this.config.onChange?.(this.api, event);
+      this.dispatchEvent(new CustomEvent('editor-change', { detail: event.detail, bubbles: true, composed: true }));
+    });
+  }
+  disconnectedCallback(): void {
+    if (!this.isConnected) this.destroy();
+  }
+  destroy(): void {
+    this.closeBlockMenu();
+    this.destroyed = true;
+    this.cleanups.splice(0).forEach((cleanup) => cleanup());
+    this.views.forEach((view) => {
+      view.dispose?.();
+      view.tool?.destroy?.();
+    });
+    this.views = [];
+    this.replaceChildren();
+  }
+  openInsertMenu(index = this.currentIndex, anchor?: HTMLElement): void {
+    this.menu.insertAfter(index, anchor);
+  }
+  openTypeMenu(id: string, event: MouseEvent): void {
+    this.menu.changeType(id, event);
+  }
+  closeBlockMenu(): void {
+    this.menu.close();
+  }
+  private trackBlock(event: Event): void {
+    const view = this.viewForEvent(event);
+    if (view) this.currentIndex = this.indexOf(view.output.id!);
+  }
+  private viewForEvent(event: Event): BlockView | undefined {
+    return this.views.find((view) => event.composedPath().includes(view.holder));
+  }
+  private reportError(error: unknown): void {
+    this.status.textContent = error instanceof Error ? error.message : String(error);
+  }
+}
+if (!customElements.get('slash-doc-editor')) customElements.define('slash-doc-editor', BlockEditorElement);

+  while (index < lines.length) {
+    const line = lines[index];
+    if (line.startsWith('    ') || line.startsWith('\t')) {
+      body.push(line.startsWith('\t') ? line.slice(1) : line.slice(4));
+      index += 1;
+      continue;
+    }
+    if (!line.trim()) {
+      body.push('');
+      index += 1;

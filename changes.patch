+  border-color: var(--vscode-button-background);
+  background: var(--vscode-button-background);
+}
+
+.mkdocs-tab-editor {
+  display: grid;
+  gap: 8px;
+}
+
+.mkdocs-tab-actions {
+  justify-content: flex-end;
+}
+
+.mkdocs-danger-button {
+  color: var(--vscode-errorForeground) !important;
+}
+
+.mkdocs-checklist {
+  display: grid;
+  gap: 6px;
+}
+
+.mkdocs-checklist-row {
+  display: grid;
+  grid-template-columns: auto minmax(100px, 1fr) auto auto auto;
+  align-items: center;
+  gap: 6px;
+  margin-left: min(calc(var(--checklist-level, 0) * 24px), 50%);
+}
+
+.mkdocs-checklist-row > input[type='checkbox'] {
+  width: 17px;

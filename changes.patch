@@ -0,0 +1,30 @@
+import type { BlockToolConstructorOptions } from './block-editor-types';
+import { sanitizeTableCellHtml } from '../shared/table-cell-html';
+import { LUCIDE_ICONS } from './lucide-icons';
+import { normalizeParagraphText } from './persistent-paragraph-tool';
+
+export default class QuoteTool {
+  private readonly text: string;
+  private readonly readOnly: boolean;
+  static get toolbox() {
+    return { title: 'Цитата', icon: LUCIDE_ICONS.quote };
+  }
+  static get conversionConfig() {
+    return { export: 'text', import: 'text' };
+  }
+  constructor({ data, readOnly }: BlockToolConstructorOptions) {
+    this.text = typeof data.text === 'string' ? data.text : '';
+    this.readOnly = readOnly;
+  }
+  render(): HTMLElement {
+    const element = document.createElement('blockquote');
+    element.className = 'ce-quote';
+    element.contentEditable = String(!this.readOnly);
+    element.dataset.placeholder = 'Введите цитату';
+    element.innerHTML = sanitizeTableCellHtml(this.text);
+    return element;
+  }
+  save(element: HTMLElement) {
+    return { text: normalizeParagraphText(element.innerHTML) };
+  }
+}
diff --git a/src/webview/rich-text-list.ts b/src/webview/rich-text-list.ts
new file mode 100644
index 0000000..d8c45ea
--- /dev/null
+++ b/src/webview/rich-text-list.ts
@@ -0,0 +1,48 @@
+import { selectRangeForNode } from './editor-selection';
+
+/** Lists stay inside the active contenteditable, including table cells and MkDocs bodies. */
+export function toggleRichTextList(cell: HTMLElement, range: Range, ordered: boolean): Range {
+  const tag = ordered ? 'ol' : 'ul';
+  const start = range.startContainer instanceof Element ? range.startContainer : range.startContainer.parentElement;
+  const existing = start?.closest<HTMLElement>('ol, ul');
+  if (existing && cell.contains(existing) && existing.contains(range.endContainer)) {
+    if (existing.tagName.toLowerCase() !== tag) {
+      const replacement = document.createElement(tag);
+      replacement.append(...Array.from(existing.childNodes));
+      existing.replaceWith(replacement);
+      range.selectNodeContents(replacement);
+    } else {
+      const fragment = document.createDocumentFragment();
+      for (const item of Array.from(existing.children)) {
+        const line = document.createElement('div');
+        line.append(...Array.from(item.childNodes));
+        fragment.append(line);
+      }
+      existing.replaceWith(fragment);
+      range.selectNodeContents(cell);
+    }
+  } else {
+    const selected = range.extractContents();
+    const list = document.createElement(tag);
+    let item = document.createElement('li');
+    for (const node of Array.from(selected.childNodes)) {
+      if (node instanceof HTMLElement && node.matches('br, div, p, li')) {
+        if (item.childNodes.length) {
+          list.append(item);
+          item = document.createElement('li');
+        }
+        if (node.tagName !== 'BR') {
+          item.append(...Array.from(node.childNodes));
+          list.append(item);
+          item = document.createElement('li');
+        }
+      } else item.append(node);
+    }
+    if (item.childNodes.length || !list.children.length) list.append(item);
+    range.insertNode(list);
+    range.selectNodeContents(list);
+  }
+  selectRangeForNode(cell, range);
+  cell.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+  return range;
+}
diff --git a/src/webview/rich-text-paste.ts b/src/webview/rich-text-paste.ts
new file mode 100644
index 0000000..3f57ed8
--- /dev/null
+++ b/src/webview/rich-text-paste.ts
@@ -0,0 +1,35 @@
+import { sanitizeTableCellHtml } from '../shared/table-cell-html';
+import { selectionForNode } from './editor-selection';
+
+export function insertRichText(target: HTMLElement, text: string, html = ''): void {
+  const fragment = document.createDocumentFragment();
+  if (html) {
+    const container = document.createElement('div');
+    const pasted = new DOMParser().parseFromString(html, 'text/html');
+    container.innerHTML = sanitizeTableCellHtml(pasted.body.innerHTML, target.dataset.slashRichBlocks === 'true');
+    fragment.append(...Array.from(container.childNodes));
+  } else {
+    text
+      .replaceAll('\r\n', '\n')
+      .replaceAll('\r', '\n')
+      .split('\n')
+      .forEach((line, index) => {
+        if (index) fragment.append(document.createElement('br'));
+        fragment.append(document.createTextNode(line));
+      });
+  }
+  target.focus();
+  const selection = selectionForNode(target);
+  const range = selection?.rangeCount ? selection.getRangeAt(0) : undefined;
+  if (!range || !target.contains(range.commonAncestorContainer)) target.append(fragment);
+  else {
+    range.deleteContents();
+    const last = fragment.lastChild;
+    range.insertNode(fragment);
+    if (last) range.setStartAfter(last);
+    range.collapse(true);
+    selection?.removeAllRanges();
+    selection?.addRange(range);
+  }
+  target.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+}

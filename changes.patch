@@ -0,0 +1,40 @@
+import type { BlockEditorElement } from './block-editor-element';
+
+export function installBlockInsertion(editor: BlockEditorElement): () => void {
+  const keydown = (event: KeyboardEvent) => {
+    const insert =
+      ((event.ctrlKey || event.metaKey) && (event.code === 'KeyI' || ['i', 'ш'].includes(event.key.toLowerCase()))) ||
+      (event.key === 'Insert' && !event.ctrlKey && !event.metaKey);
+    if (!insert || event.shiftKey || event.altKey || event.isComposing || editor.readOnly) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    editor.openInsertMenu();
+  };
+  const click = (event: MouseEvent) => {
+    if (editor.readOnly || event.button !== 0 || event.defaultPrevented) return;
+    const target = event.target;
+    const parent = editor.parentElement;
+    const redactor = editor.querySelector('.codex-editor__redactor');
+    const view = editor.views.find(
+      (item) => item.holder === target || item.holder.querySelector('.slash-block-insertion-space') === target,
+    );
+    // Only editor whitespace creates paragraphs; blank widget canvases keep their own interactions.
+    if (target !== editor && target !== parent && target !== redactor && !view) return;
+    event.preventDefault();
+    const index = editor.views.findIndex((item) => event.clientY < item.holder.getBoundingClientRect().top);
+    editor.api.blocks.insert(
+      'paragraph',
+      { text: '' },
+      undefined,
+      view ? editor.indexOf(view.output.id!) + 1 : index < 0 ? editor.views.length : index,
+      true,
+    );
+  };
+  editor.addEventListener('keydown', keydown, true);
+  const parent = editor.parentElement;
+  (parent ?? editor).addEventListener('click', click as EventListener);
+  return () => {
+    editor.removeEventListener('keydown', keydown, true);
+    (parent ?? editor).removeEventListener('click', click as EventListener);
+  };
+}
diff --git a/src/webview/block-editor-keyboard.ts b/src/webview/block-editor-keyboard.ts
new file mode 100644
index 0000000..dd9ade9
--- /dev/null
+++ b/src/webview/block-editor-keyboard.ts
@@ -0,0 +1,62 @@
+import type { BlockEditorElement } from './block-editor-element';
+import { selectionForNode } from './editor-selection';
+
+export function handleBlockKeydown(editor: BlockEditorElement, event: KeyboardEvent): void {
+  if (editor.readOnly || event.defaultPrevented || event.isComposing) return;
+  if (editor.selected.size) {
+    if (event.key === 'Escape') {
+      editor.clearSelection();
+      event.preventDefault();
+    }
+    if (event.key === 'Backspace' || event.key === 'Delete') {
+      event.preventDefault();
+      editor.deleteSelected();
+    }
+    if (event.shiftKey && ['ArrowUp', 'ArrowDown'].includes(event.key)) {
+      const index = editor.currentIndex + (event.key === 'ArrowUp' ? -1 : 1);
+      const next = editor.views[index];
+      if (next) {
+        event.preventDefault();
+        editor.selectBlock(next.output.id!, true);
+      }
+    }
+    return;
+  }
+  const text = event
+    .composedPath()
+    .find(
+      (node): node is HTMLElement =>
+        node instanceof HTMLElement && node.matches('.ce-paragraph, .ce-header, .ce-quote'),
+    );
+  if (!text) return;
+  const selection = selectionForNode(text);
+  const range = selection?.rangeCount ? selection.getRangeAt(0) : undefined;
+  if (!range || !text.contains(range.commonAncestorContainer)) return;
+  if (event.key === 'Enter' && !event.shiftKey && !range.startContainer.parentElement?.closest('li')) {
+    event.preventDefault();
+    range.deleteContents();
+    const tail = document.createRange();
+    tail.selectNodeContents(text);
+    tail.setStart(range.startContainer, range.startOffset);
+    const fragment = document.createElement('div');
+    fragment.append(tail.extractContents());
+    editor.api.blocks.insert('paragraph', { text: fragment.innerHTML }, undefined, editor.currentIndex + 1, true);
+    editor.changed();
+  }
+  if (event.key === 'Backspace' && range.collapsed && editor.currentIndex > 0) {
+    const before = range.cloneRange();
+    before.selectNodeContents(text);
+    before.setEnd(range.startContainer, range.startOffset);
+    if (before.toString().length) return;
+    const previous = editor.views[editor.currentIndex - 1];
+    const previousText = previous.content.querySelector<HTMLElement>('.ce-paragraph, .ce-header, .ce-quote');
+    if (!previousText) return;
+    event.preventDefault();
+    const index = editor.currentIndex;
+    editor.api.caret.setToBlock(index - 1, 'end');
+    previousText.insertAdjacentHTML('beforeend', text.innerHTML);
+    editor.deleteBlock(index, false);
+    editor.currentIndex = index - 1;
+    editor.changed(previous);
+  }
+}
diff --git a/src/webview/block-editor-menu.ts b/src/webview/block-editor-menu.ts
new file mode 100644
index 0000000..8eda74d
--- /dev/null
+++ b/src/webview/block-editor-menu.ts
@@ -0,0 +1,133 @@
+import type { BlockEditorElement } from './block-editor-element';
+import { button, toolSettings } from './block-editor-view';
+import { convertBlockType } from './block-editor-conversion';
+import { LUCIDE_ICONS } from './lucide-icons';
+import { orderedBlockTypes } from '../shared/block-tool-order';
+
+export class BlockEditorMenu {
+  private menu?: HTMLElement;
+  private restoreFocus?: HTMLElement;
+  private cleanups: Array<() => void> = [];
+  constructor(private readonly editor: BlockEditorElement) {}
+  insertAfter(index: number, anchor?: HTMLElement): void {
+    const id = this.editor.views[index]?.output.id;
+    this.open(
+      'Добавить блок',
+      anchor?.getBoundingClientRect() ?? this.editor.views[index]?.holder.getBoundingClientRect(),
+      async (type) => {
+        const target = id ? this.editor.indexOf(id) : this.editor.views.length - 1;
+        if (id && target < 0) return;
+        this.editor.api.blocks.insert(type, {}, undefined, target + 1, true);
+      },
+    );
+  }
+  changeType(id: string, event: MouseEvent): void {
+    event.preventDefault();
+    event.stopPropagation();
+    this.open(
+      'Тип блока',
+      event.type === 'contextmenu' || !(event.currentTarget instanceof HTMLElement)
+        ? { left: event.clientX, bottom: event.clientY }
+        : event.currentTarget.getBoundingClientRect(),
+      (type) => convertBlockType(this.editor, id, type),
+      this.editor.views.find((view) => view.output.id === id)?.output.type,
+    );
+  }
+  close(restore = false): void {
+    this.cleanups.splice(0).forEach((cleanup) => cleanup());
+    this.menu?.remove();
+    this.menu = undefined;
+    if (restore && this.restoreFocus?.isConnected) this.restoreFocus.focus();
+  }
+  private open(
+    title: string,
+    rect: Pick<DOMRect, 'left' | 'bottom'> | undefined,
+    action: (type: string) => Promise<void>,
+    current?: string,
+  ): void {
+    this.close();
+    if (this.editor.readOnly) return;
+    this.restoreFocus = document.activeElement instanceof HTMLElement ? document.activeElement : this.editor;
+    const menu = document.createElement('div');
+    menu.className = 'slash-block-menu';
+    menu.setAttribute('role', 'dialog');
+    menu.setAttribute('aria-label', title);
+    const heading = document.createElement('strong');
+    heading.textContent = title;
+    const search = document.createElement('input');
+    search.type = 'search';
+    search.placeholder = 'Поиск блоков';
+    search.setAttribute('aria-label', 'Поиск блоков');
+    const list = document.createElement('div');
+    list.setAttribute('role', 'menu');
+    const buttons: HTMLButtonElement[] = [];
+    for (const name of orderedBlockTypes(Object.keys(this.editor.config.tools ?? {}))) {
+      const settings = toolSettings(this.editor.config.tools!, name)!;
+      if (settings.class.isInline || settings.toolbox === false) continue;
+      const label = settings.toolbox?.title ?? settings.class.toolbox?.title ?? name;
+      const item = button(label, '');
+      const icon = document.createElement('span');
+      icon.className = 'slash-block-menu-icon';
+      icon.setAttribute('aria-hidden', 'true');
+      icon.innerHTML = settings.toolbox?.icon ?? settings.class.toolbox?.icon ?? LUCIDE_ICONS.panelsTopLeft;
+      const text = document.createElement('span');
+      text.textContent = label;
+      item.append(icon, text);
+      item.dataset.blockType = name;
+      item.setAttribute('role', 'menuitem');
+      if (name === current) item.setAttribute('aria-current', 'true');
+      item.addEventListener('click', () => {
+        this.close();
+        void action(name).catch((error: unknown) => {
+          this.editor.status.textContent = error instanceof Error ? error.message : String(error);
+        });
+      });
+      buttons.push(item);
+      list.append(item);
+    }
+    search.addEventListener('input', () => {
+      buttons.forEach((item) => {
+        item.hidden = !item.textContent?.toLocaleLowerCase().includes(search.value.toLocaleLowerCase());
+      });
+    });
+    menu.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        event.stopPropagation();
+        this.close(true);
+      }
+      const visible = buttons.filter((item) => !item.hidden);
+      const index = visible.indexOf(document.activeElement as HTMLButtonElement);
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        visible[(index + (event.key === 'ArrowDown' ? 1 : -1) + visible.length) % visible.length]?.focus();
+      }
+      if (event.key === 'Enter' && event.target === search) {
+        event.preventDefault();
+        visible[0]?.click();
+      }
+    });
+    menu.append(heading, search, list);
+    document.body.append(menu);
+    this.menu = menu;
+    const bounds = menu.getBoundingClientRect();
+    menu.style.left = `${Math.max(8, Math.min(rect?.left ?? 8, window.innerWidth - bounds.width - 8))}px`;
+    menu.style.top = `${Math.max(8, Math.min(rect?.bottom ?? 8, window.innerHeight - bounds.height - 8))}px`;
+    const outside = (event: Event) => {
+      if (!event.composedPath().includes(menu)) this.close();
+    };
+    const close = () => this.close();
+    const scroll = (event: Event) => {
+      if (!event.composedPath().includes(menu)) this.close();
+    };
+    document.addEventListener('pointerdown', outside, true);
+    window.addEventListener('resize', close);
+    window.addEventListener('scroll', scroll, true);
+    this.cleanups.push(
+      () => document.removeEventListener('pointerdown', outside, true),
+      () => window.removeEventListener('resize', close),
+      () => window.removeEventListener('scroll', scroll, true),
+    );
+    search.focus({ preventScroll: true });
+  }
+}
diff --git a/src/webview/block-editor-movement.ts b/src/webview/block-editor-movement.ts
new file mode 100644
index 0000000..d99739f
--- /dev/null
+++ b/src/webview/block-editor-movement.ts
@@ -0,0 +1,55 @@
+import type { BlockEditorElement } from './block-editor-element';
+import { selectionForNode } from './editor-selection';
+
+export function handleBlockMovement(editor: BlockEditorElement, event: KeyboardEvent): void {
+  if (
+    editor.readOnly ||
+    event.defaultPrevented ||
+    event.isComposing ||
+    event.altKey ||
+    event.shiftKey ||
+    !(event.ctrlKey || event.metaKey) ||
+    !['ArrowUp', 'ArrowDown'].includes(event.key)
+  )
+    return;
+  const direction = event.key === 'ArrowUp' ? -1 : 1;
+  const source = editor.views.find((view) => event.composedPath().includes(view.holder));
+  const active = event.composedPath().find((node): node is HTMLElement => node instanceof HTMLElement);
+  const selection = active ? selectionForNode(active) : null;
+  const range = selection?.rangeCount ? selection.getRangeAt(0).cloneRange() : undefined;
+  // Retain the actual endpoints: live Range boundaries can change when DOM nodes move.
+  const caret = range && {
+    start: range.startContainer,
+    startOffset: range.startOffset,
+    end: range.endContainer,
+    endOffset: range.endOffset,
+  };
+  const moving = editor.selected.size
+    ? editor.views.filter((view) => editor.selected.has(view.output.id!))
+    : [source ?? editor.views[editor.currentIndex]].filter((view) => !!view);
+  if (!moving.length) return;
+  event.preventDefault();
+  event.stopImmediatePropagation();
+  if (
+    moving.some(
+      (view) =>
+        editor.indexOf(view.output.id!) + direction < 0 ||
+        editor.indexOf(view.output.id!) + direction >= editor.views.length,
+    )
+  )
+    return;
+  const currentId = editor.views[editor.currentIndex]?.output.id;
+  for (const view of direction < 0 ? moving : [...moving].reverse()) {
+    const index = editor.indexOf(view.output.id!);
+    editor.move(index + direction, index);
+  }
+  if (currentId) editor.currentIndex = editor.indexOf(currentId);
+  if (active?.isConnected) active.focus({ preventScroll: true });
+  if (caret && range && selection && caret.start.isConnected && caret.end.isConnected) {
+    range.setStart(caret.start, caret.startOffset);
+    range.setEnd(caret.end, caret.endOffset);
+    selection.removeAllRanges();
+    selection.addRange(range);
+  }
+  moving[direction < 0 ? 0 : moving.length - 1].holder.scrollIntoView({ block: 'nearest' });
+}
diff --git a/src/webview/block-editor-selection.ts b/src/webview/block-editor-selection.ts
new file mode 100644
index 0000000..66fd92b
--- /dev/null
+++ b/src/webview/block-editor-selection.ts
@@ -0,0 +1,210 @@
+import type { BlockEditorElement } from './block-editor-element';
+
+type Point = { x: number; y: number };
+type Rectangle = { left: number; top: number; right: number; bottom: number };
+
+export function selectionRectangle(start: Point, end: Point): Rectangle {
+  return {
+    left: Math.min(start.x, end.x),
+    top: Math.min(start.y, end.y),
+    right: Math.max(start.x, end.x),
+    bottom: Math.max(start.y, end.y),
+  };
+}
+
+export function intersectsSelection(selection: Rectangle, block: Rectangle): boolean {
+  return (
+    selection.left < block.right &&
+    selection.right > block.left &&
+    selection.top < block.bottom &&
+    selection.bottom > block.top
+  );
+}
+
+/** Start only in editor whitespace so text, widgets and block dragging retain their gestures. */
+export function installBlockAreaSelection(editor: BlockEditorElement): () => void {
+  const scope = editor.parentElement ?? editor;
+  const marquee = document.createElement('div');
+  marquee.className = 'slash-block-selection-area';
+  marquee.setAttribute('aria-hidden', 'true');
+  let gesture:
+    | {
+        pointerId: number;
+        start: Point;
+        point: Point;
+        initial: Point;
+        before: Set<string>;
+        index: number;
+        additive: boolean;
+        active: boolean;
+        scroll: HTMLElement;
+      }
+    | undefined;
+  let frame: number | undefined;
+  let suppressClick = false;
+
+  const update = () => {
+    if (!gesture?.active) return;
+    const rect = editor.getBoundingClientRect();
+    const area = selectionRectangle({ x: rect.left + gesture.start.x, y: rect.top + gesture.start.y }, gesture.point);
+    Object.assign(marquee.style, {
+      left: `${area.left}px`,
+      top: `${area.top}px`,
+      width: `${area.right - area.left}px`,
+      height: `${area.bottom - area.top}px`,
+    });
+    const hits = editor.views
+      .filter((view) => {
+        const bounds = view.holder.getBoundingClientRect();
+        // The empty insertion strip below a block is not part of its visible content.
+        return intersectsSelection(area, {
+          left: bounds.left,
+          right: bounds.right,
+          top: bounds.top,
+          bottom: Math.min(
+            bounds.bottom,
+            view.content.getBoundingClientRect().bottom + parseFloat(getComputedStyle(view.holder).paddingBottom),
+          ),
+        });
+      })
+      .map((view) => view.output.id!);
+    const ids = new Set(gesture.additive ? gesture.before : []);
+    hits.forEach((id) => ids.add(id));
+    const active = gesture.point.y < rect.top + gesture.start.y ? hits[0] : hits.at(-1);
+    editor.selectBlocks(ids, active);
+  };
+
+  const autoScroll = () => {
+    frame = undefined;
+    if (!gesture?.active) return;
+    if (editor.readOnly || !editor.isConnected) {
+      finish(true);
+      return;
+    }
+    const scrolling = gesture.scroll;
+    const bounds =
+      scrolling === document.scrollingElement
+        ? { top: 0, bottom: window.innerHeight }
+        : scrolling.getBoundingClientRect();
+    const top = Math.max(0, bounds.top);
+    const bottom = Math.min(window.innerHeight, bounds.bottom);
+    const y = gesture.point.y;
+    const speed =
+      y < top + 32 ? -Math.min(18, (top + 32 - y) / 2) : y > bottom - 32 ? Math.min(18, (y - bottom + 32) / 2) : 0;
+    if (speed) {
+      const previous = scrolling.scrollTop;
+      scrolling.scrollTop += speed;
+      if (previous !== scrolling.scrollTop) update();
+    }
+    frame = window.requestAnimationFrame(autoScroll);
+  };
+
+  const finish = (cancel = false) => {
+    if (!gesture) return;
+    const previous = gesture;
+    gesture = undefined;
+    if (frame !== undefined) window.cancelAnimationFrame(frame);
+    frame = undefined;
+    marquee.remove();
+    editor.classList.remove('slash-block-area-selecting');
+    if (scope.hasPointerCapture(previous.pointerId)) scope.releasePointerCapture(previous.pointerId);
+    if (cancel && previous.active) {
+      editor.selectBlocks(previous.before, editor.views[previous.index]?.output.id);
+      editor.currentIndex = previous.index;
+    }
+  };
+
+  const down = (event: PointerEvent) => {
+    // Reset on a new gesture, retaining suppression through mouseup after Escape.
+    if (!gesture) suppressClick = false;
+    if (editor.readOnly || event.button !== 0 || !event.isPrimary || event.pointerType !== 'mouse') return;
+    const target = event.target;
+    if (!(target instanceof HTMLElement)) return;
+    if (
+      target !== scope &&
+      target !== editor &&
+      target !== editor.querySelector('.codex-editor__redactor') &&
+      !(target.matches('.slash-block-insertion-space') && editor.contains(target))
+    )
+      return;
+    finish(true);
+    suppressClick = false;
+    const rect = editor.getBoundingClientRect();
+    gesture = {
+      pointerId: event.pointerId,
+      start: { x: event.clientX - rect.left, y: event.clientY - rect.top },
+      point: { x: event.clientX, y: event.clientY },
+      initial: { x: event.clientX, y: event.clientY },
+      before: new Set(editor.selected),
+      index: editor.currentIndex,
+      additive: event.ctrlKey || event.metaKey || event.shiftKey,
+      active: false,
+      scroll: findScrollContainer(scope),
+    };
+  };
+  const move = (event: PointerEvent) => {
+    if (!gesture || gesture.pointerId !== event.pointerId) return;
+    gesture.point = { x: event.clientX, y: event.clientY };
+    if (!gesture.active) {
+      if (Math.hypot(event.clientX - gesture.initial.x, event.clientY - gesture.initial.y) < 5) return;
+      gesture.active = true;
+      suppressClick = true;
+      editor.closeBlockMenu();
+      editor.focus({ preventScroll: true });
+      window.getSelection()?.removeAllRanges();
+      editor.classList.add('slash-block-area-selecting');
+      document.body.append(marquee);
+      scope.setPointerCapture(event.pointerId);
+      frame = window.requestAnimationFrame(autoScroll);
+    }
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    update();
+  };
+  const up = (event: PointerEvent) => {
+    if (!gesture || gesture.pointerId !== event.pointerId) return;
+    if (gesture.active && event.type === 'pointerup') {
+      gesture.point = { x: event.clientX, y: event.clientY };
+      update();
+      event.preventDefault();
+    }
+    finish(event.type === 'pointercancel');
+  };
+  const cancel = (event: KeyboardEvent) => {
+    if (!gesture || event.key !== 'Escape') return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    finish(true);
+  };
+  const click = (event: MouseEvent) => {
+    if (!suppressClick || event.button !== 0) return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    suppressClick = false;
+  };
+  const blur = () => finish(true);
+  scope.addEventListener('pointerdown', down, true);
+  scope.addEventListener('click', click, true);
+  document.addEventListener('pointermove', move, { capture: true, passive: false });
+  document.addEventListener('pointerup', up, true);
+  document.addEventListener('pointercancel', up, true);
+  window.addEventListener('keydown', cancel, true);
+  window.addEventListener('blur', blur);
+  return () => {
+    finish();
+    scope.removeEventListener('pointerdown', down, true);
+    scope.removeEventListener('click', click, true);
+    document.removeEventListener('pointermove', move, true);
+    document.removeEventListener('pointerup', up, true);
+    document.removeEventListener('pointercancel', up, true);
+    window.removeEventListener('keydown', cancel, true);
+    window.removeEventListener('blur', blur);
+  };
+}
+
+function findScrollContainer(element: HTMLElement): HTMLElement {
+  for (let node: HTMLElement | null = element; node; node = node.parentElement) {
+    if (/(auto|scroll)/.test(getComputedStyle(node).overflowY) && node.scrollHeight > node.clientHeight) return node;
+  }
+  return document.scrollingElement as HTMLElement;
+}

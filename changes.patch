+  let frame = await loadedPage('first');
+  assert.ok(await page.$eval('link[rel="icon"]', (link) => link.href.startsWith('data:image/svg+xml,')));
+  assert.equal(await page.$eval('.documentation-logo', (logo) => logo.getAttribute('href')), '/');
